<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================
         PARENT POM
         ===================================================== -->

    <parent>
        <groupId>com.hms</groupId>
        <artifactId>hms-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- =====================================================
         PROJECT INFORMATION
         ===================================================== -->

    <groupId>com.hms</groupId>
    <artifactId>hms-webb</artifactId>
    <version>1.0.0</version>
    <name>HMS Webb</name>
    <description>Hospital Management System - Web UI Module (serves the Angular build as static content, forwards /api/** to hms-jar)</description>
    <packaging>jar</packaging>

    <!-- =====================================================
         NOTE
         ===================================================== -->

    <!-- The Angular app lives in ./angular and is built independently
         with npm/ng. `ng build` writes its output directly into
         src/main/resources/static (see angular.json outputPath) —
         there is no Maven copy step. This module serves that folder as
         static content and forwards /api/** to hms-jar's Backend API. -->

    <!-- =====================================================
         DEPENDENCIES
         ===================================================== -->

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <!-- =====================================================
         BUILD
         ===================================================== -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
